<section class="subgroup">
    <div class="row">
        <span class="left"><p><b @text="school"></b></p></span>
        <span class="right"><p @text="date"></p></span>
    </div>
    <div class="row">
        <span class="left"><p><i @text="degree"></i></p></span>
        <span class="right"><p @text="location"></p></span>
    </div>
    <div class="row">
        <span class="left">
            <slot></slot>
        </span>
    </div>
</section>