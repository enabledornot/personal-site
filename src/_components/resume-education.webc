<div class="subgroup">
    <div class="row">
        <span class="left"><b @text="school"></b></span>
        <span class="right" @text="date"></span>
    </div>
    <div class="row">
        <span class="left"><i @text="degree"></i></span>
        <span class="right" @text="location"></span>
    </div>
    <div class="row">
        <slot></slot>
    </div>
</div>