<section class="subgroup">
    <div class="row">
        <span class="left">
            <p>
                <a webc:if="typeof url === 'string'" :href="url" target="_blank"><b @text="title"></b></a>
                <b webc:else @text="title"></b>
            </p>
        </span>
        <span class="right"><p @text="date"></p></span>
    </div>
    <div class="row">
        <span class="left"><p><i @text="description"></i></p></span>
    </div>
    <div class="row">
        <span class="left">
            <slot></slot>
        </span>
    </div>
</section>